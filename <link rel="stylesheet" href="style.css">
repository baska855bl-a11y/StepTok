body {
  font-family: Arial, sans-serif;
  text-align: center;
  padding: 50px;
  background-color: #f5f5f5;
}

h1 {
  color: #333;
}

.buttons {
  margin: 20px 0;
}

button {
  padding: 12px 25px;
  margin: 10px;
  font-size: 16px;
  cursor: pointer;
  border-radius: 5px;
  border: none;
  background-color: #007bff;
  color: white;
  transition: background-color 0.3s;
}

button:hover {
  background-color: #0056b3;
}

#preview {
  margin-top: 30px;
}

#preview img, #preview video {
  max-width: 300px;
  margin: 10px;
  border-radius: 5px;
}
