/* Základný štýl */
body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  min-height: 100vh;
  background: #f0f0f0;
  transition: background-color 0.3s ease;
}

header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 20px;
  background-color: #ff5555;
  color: white;
  font-size: 24px;
}

button {
  padding: 10px;
  background-color: #ff5555;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background-color: #ff2222;
}

/* Pre registráciu a prihlásenie */
.form-container {
  background: white;
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  width: 350px;
  margin-bottom: 20px;
}

input {
  width: 100%;
  padding: 10px;
  margin-top: 10px;
  border-radius: 8px;
  border: 1px solid #ccc;
}

.hidden {
  display: none;
}

/* Feed videí */
.feed-container {
  display: flex;
  justify-content: center;
  margin-top: 30px;
  width: 100%;
}

.video-container {
  width: 300px;
  height: 500px;
  background: #ddd;
  margin: 10px;
  border-radius: 10px;
}

/* Tmavý režim */
body.dark-mode {
  background-color: #121212;
  color: white;
}

body.dark-mode header {
  background-color: #333;
}

body.dark-mode .form-container {
  background-color: #2c2c2c;
  color: white;
  border-color: #444;
}

body.dark-mode input {
  background-color: #444;
  color: white;
  border-color: #666;
}
