.container {
  width: 100%;
  max-width: 500px;
  padding: 20px;
  background-image: url('your-image-url.jpg'); /* Obrázok ako pozadie */
  background-size: cover;
  background-position: center;
  border-radius: 10px;
  box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.2);
  text-align: center;
  color: white; /* Ak použiješ obrázok na pozadí, biela farba písma môže byť lepšia */
}
