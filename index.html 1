<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StepTok</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #f1f1f1;
      color: #000;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 400px;
      padding: 20px;
      background-color: rgba(255, 255, 255, 0.8);
      border-radius: 10px;
      box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.2);
      text-align: center;
    }

    h2 {
      margin-bottom: 20px;
    }

    input {
      margin: 10px 0;
      padding: 10px;
      width: 100%;
      border-radius: 5px;
      border: 1px solid #ccc;
    }

    button {
      padding: 10px;
      width: 100%;
      border-radius: 5px;
      background-color: #007BFF;
      color: white;
      border: none;
      margin-top: 15px;
    }

    button:hover {
      background-color: #0056b3;
    }

    .alternative {
      margin-top: 10px;
    }

    .alternative a {
      color: #007BFF;
      text-decoration: none;
    }

    .alternative a:hover {
      text-decoration: underline;
    }

    .theme-toggle {
      margin-top: 20px;
    }

    .theme-toggle button {
      padding: 10px;
      border-radius: 5px;
      background-color: #444;
      color: white;
      border: none;
    }
  </style>
</head>
<body>

  <!-- Kontajner pre prihlasenie a registráciu -->
  <div class="container">
    <h2>Log in to StepTok</h2>
    <!-- Prihlasovací formulár -->
    <input type="text" id="loginInput" placeholder="Username or Email" />
    <input type="password" id="passwordInput" placeholder="Password" />
    
    <!-- Checkbox na použitie telefónneho čísla -->
    <div class="alternative">
      <label>
        <input type="checkbox" id="usePhone" /> Use phone number instead
      </label>
    </div>

    <!-- Tlačidlo na prihlásenie -->
    <button onclick="login()">Log In</button>

    <!-- Odkaz na registráciu -->
    <div class="alternative">
      <p>Don't have an account? <a href="javascript:void(0);" onclick="toggleRegister()">Sign up here</a></p>
    </div>

    <!-- Formulár pre registráciu -->
    <div id="registerForm" style="display: none;">
      <h2>Sign up to StepTok</h2>
      <input type="text" id="registerUsername" placeholder="Choose a username" />
      <input type="email" id="registerEmail" placeholder="Email" />
      <input type="password" id="registerPassword" placeholder="Create a password" />
      <button onclick="register()">Sign Up</button>
      <div class="alternative">
        <p>Already have an account? <a href="javascript:void(0);" onclick="toggleLogin()">Log in here</a></p>
      </div>
    </div>

    <!-- Prepínanie medzi svetlým a tmavým režimom -->
    <div class="theme-toggle">
      <button onclick="toggleTheme()">Toggle Theme</button>
    </div>
  </div>

  <script>
    let isDarkMode = false;
    const body = document.querySelector('body');
    const loginInput = document.getElementById('loginInput');
    const passwordInput = document.getElementById('passwordInput');
    const registerUsername = document.getElementById('registerUsername');
    const registerEmail = document.getElementById('registerEmail');
    const registerPassword = document.getElementById('registerPassword');
    const usePhoneCheckbox = document.getElementById('usePhone');
    const loginForm = document.querySelector('.container');
    const registerForm = document.getElementById('registerForm');

    // Funkcia na prepnutie na registráciu
    function toggleRegister() {
      loginForm.style.display = 'none';
      registerForm.style.display = 'block';
    }

    // Funkcia na prepnutie späť na prihlásenie
    function toggleLogin() {
      loginForm.style.display = 'block';
      registerForm.style.display = 'none';
    }

    // Funkcia na prihlásenie
    function login() {
      const loginValue = loginInput.value;
      const password = passwordInput.value;

      if (loginValue && password) {
        if (usePhoneCheckbox.checked) {
          alert("Login via phone number: " + loginValue);
        } else {
          alert("Login via username or email: " + loginValue);
        }
        alert("Successfully logged in!");
      } else {
        alert("Please enter your username/email and password!");
      }
    }

    // Funkcia na registráciu
    function register() {
      const username = registerUsername.value;
      const email = registerEmail.value;
      const password = registerPassword.value;

      if (username && email && password) {
        alert(`Successfully registered with username: ${username} and email: ${email}`);
        toggleLogin(); // Prepneme späť na prihlásenie po registrácii
      } else {
        alert("Please fill all registration fields!");
      }
    }

    // Funkcia na prepínanie medzi svetlým a tmavým režimom
    function toggleTheme() {
      isDarkMode = !isDarkMode;
      body.style.backgroundColor = isDarkMode ? '#121212' : '#f1f1f1';
      body.style.color = isDarkMode ? '#fff' : '#000';
    }
  </script>

</body>
</html>
