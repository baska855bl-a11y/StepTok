<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StepTok</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #f1f1f1;
      color: #000;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 400px;
      padding: 20px;
      background-color: rgba(255, 255, 255, 0.8);
      border-radius: 10px;
      box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.2);
      text-align: center;
    }

    h2 {
      margin-bottom: 20px;
    }

    input {
      margin: 10px 0;
      padding: 10px;
      width: 100%;
      border-radius: 5px;
      border: 1px solid #ccc;
    }

    button {
      padding: 10px;
      width: 100%;
      border-radius: 5px;
      background-color: #007BFF;
      color: white;
      border: none;
      margin-top: 15px;
    }

    button:hover {
      background-color: #0056b3;
    }

    .alternative {
      margin-top: 10px;
    }

    .alternative a {
      color: #007BFF;
      text-decoration: none;
    }

    .alternative a:hover {
      text-decoration: underline;
    }

    .theme-toggle {
      margin-top: 20px;
    }

    .theme-toggle button {
      padding: 10px;
      border-radius: 5px;
      background-color: #444;
      color: white;
      border: none;
    }
  </style>
</head>
<body>

  <!-- Kontajner pre registráciu a prihlásenie -->
  <div class="container" id="authContainer">
    <h2>Sign up to StepTok</h2>
    <!-- Formulár pre registráciu -->
    <input type="text" id="registerUsername" placeholder="Choose a username" />
    <input type="email" id="registerEmail" placeholder="Email" />
    <input type="password" id="registerPassword" placeholder="Create a password" />
    <button onclick="register()">Sign Up</button>

    <div class="alternative">
      <p>Already have an account? <a href="javascript:void(0);" onclick="toggleLogin()">Log in here</a></p>
    </div>
  </div>

  <!-- Formulár pre prihlásenie -->
  <div class="container" id="loginContainer" style="display: none;">
    <h2>Log in to StepTok</h2>
    <input type="text" id="loginInput" placeholder="Username or Email" />
    <input type="password" id="passwordInput" placeholder="Password" />
    <div class="alternative">
      <label>
        <input type="checkbox" id="usePhone" /> Use phone number instead
      </label>
    </div>
    <button onclick="login()">Log In</button>

    <div class="alternative">
      <p>Don't have an account? <a href="javascript:void(0);" onclick="toggleRegister()">Sign up here</a></p>
    </div>
  </div>

  <!-- Prepínanie medzi svetlým a tmavým režimom -->
  <div class="theme-toggle">
    <button onclick="toggleTheme()">Toggle Theme</button>
  </div>

  <script>
    let isDarkMode = false;
    const body = document.querySelector('body');
    const loginInput = document.getElementById('loginInput');
    const passwordInput = document.getElementById('passwordInput');
    const registerUsername = document.getElementById('registerUsername');
    const registerEmail = document.getElementById('registerEmail');
    const registerPassword = document.getElementById('registerPassword');
    const usePhoneCheckbox = document.getElementById('usePhone');
    const authContainer = document.getElementById('authContainer');
    const loginContainer = document.getElementById('loginContainer');

    // Funkcia na prepnutie na prihlásenie
    function toggleLogin() {
      authContainer.style.display = 'none';
      loginContainer.style.display = 'block';
    }

    // Funkcia na prepnutie späť na registráciu
    function toggleRegister() {
      authContainer.style.display = 'block';
      loginContainer.style.display = 'none';
    }

    // Funkcia na registráciu
    function register() {
      const username = registerUsername.value;
      const email = registerEmail.value;
      const password = registerPassword.value;

      if (username && email && password) {
        alert(`Successfully registered with username: ${username} and email: ${email}`);
        toggleLogin(); // Po registrácii prepni na prihlásenie
      } else {
        alert("Please fill all registration fields!");
      }
    }

